{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lore.local/novel/characters/character.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["version", "revision", "characters", "disclosure_checkpoints"],
  "properties": {"version": {"const": 3}, "revision": {"type": "integer", "minimum": 1},
    "disclosure_checkpoints": {"type": "object", "additionalProperties": {"$ref": "#/$defs/claim"}},
    "characters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/character"}}},
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "evidence": {"$ref": "../reference/metadata.schema.json#/$defs/evidence"},
    "claim": {"$ref": "../reference/metadata.schema.json#/$defs/claim"},
    "metadata": {"$ref": "../reference/metadata.schema.json#/$defs/metadata"},
    "hint": {"type": "object", "additionalProperties": false, "required": ["after_events", "claim"],
      "properties": {"after_events": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "claim": {"$ref": "#/$defs/claim"}}},
    "release": {"type": "object", "additionalProperties": false,
      "required": ["spoiler", "after_events", "foreshadowing", "policy_metadata"],
      "properties": {"spoiler": {"enum": ["minor", "major"]},
        "after_events": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "foreshadowing": {"type": "array", "items": {"$ref": "#/$defs/hint"}},
        "policy_metadata": {"$ref": "#/$defs/metadata"}}},
    "disclosure": {"type": "object", "additionalProperties": false,
      "required": ["master_visibility", "default", "public_id", "public_display_name", "after_events", "fact_after", "policy_metadata"],
      "properties": {"master_visibility": {"const": "author_only"}, "default": {"const": "sealed"},
        "public_id": {"type": "string"}, "public_display_name": {"type": "string"},
        "after_events": {"$ref": "#/$defs/strings"},
        "fact_after": {"type": "object", "additionalProperties": {"$ref": "#/$defs/strings"}},
        "policy_metadata": {"$ref": "#/$defs/metadata"}}},
    "name": {"type": "object", "additionalProperties": false,
      "required": ["value", "origin", "literal_ids", "evidence", "metadata"],
      "properties": {"value": {"type": ["string", "null"]},
        "origin": {"enum": ["source_exact", "source_adaptation", "authored", "unknown"]},
        "literal_ids": {"$ref": "#/$defs/strings"}, "evidence": {"$ref": "#/$defs/evidence"},
        "metadata": {"$ref": "#/$defs/metadata"}}},
    "character": {"type": "object", "additionalProperties": false,
      "required": ["revision", "kind", "canonical_name", "korean_name", "biography", "resource_refs", "source_excerpts", "display_name", "display_name_metadata", "aliases", "source_facts", "writing", "relationships", "disclosure"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["protagonist", "initial_candidate", "npc", "optional_companion", "antagonist", "boss", "creature"]},
        "canonical_name": {"$ref": "#/$defs/name"}, "display_name": {"type": "string", "minLength": 1},
        "display_name_metadata": {"$ref": "#/$defs/metadata"},
        "disclosure": {"$ref": "#/$defs/disclosure"},
        "korean_name": {"$ref": "#/$defs/claim"},
        "writing_name": {"$ref": "#/$defs/claim"},
        "biography": {"type": "object", "additionalProperties": false,
          "required": ["age", "gender", "species", "occupation", "appearance", "alignment"],
          "properties": {"age": {"$ref": "#/$defs/claim"}, "gender": {"$ref": "#/$defs/claim"},
            "species": {"$ref": "#/$defs/claim"}, "occupation": {"$ref": "#/$defs/claim"},
            "appearance": {"$ref": "#/$defs/claim"}, "alignment": {"$ref": "#/$defs/claim"}}},
        "resource_refs": {"type": "object", "additionalProperties": false,
          "required": ["equipment", "abilities", "enemy_templates"],
          "properties": {"equipment": {"$ref": "#/$defs/strings"}, "abilities": {"$ref": "#/$defs/strings"},
            "enemy_templates": {"$ref": "#/$defs/strings"}}},
        "source_excerpts": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["literal_id", "text"], "properties": {"literal_id": {"type": "string"}, "text": {"type": "string"}}}},
        "aliases": {"$ref": "#/$defs/strings"},
        "source_facts": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "writing": {"type": "object", "additionalProperties": false,
          "required": ["status", "traits", "speech", "goals", "boundaries", "notes"],
          "properties": {"status": {"enum": ["outline", "draft", "approved"]},
            "traits": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
            "speech": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
            "goals": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
            "boundaries": {"$ref": "#/$defs/strings"}, "notes": {"type": "string"}}},
        "relationships": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["id", "target", "relation_type", "truth_type", "claimant", "branch_condition", "description", "origin", "status", "evidence", "metadata", "disclosure"],
          "properties": {"id": {"type": "string"}, "target": {"type": "string"}, "description": {"type": "string"},
            "relation_type": {"type": "string"},
            "truth_type": {"enum": ["source_event", "testimony", "document_claim", "inferred", "authored"]},
            "claimant": {"type": ["string", "null"]}, "branch_condition": {"type": "string"},
            "disclosure": {"$ref": "#/$defs/release"},
            "origin": {"enum": ["source_adaptation", "inferred", "authored"]}, "status": {"enum": ["confirmed", "proposed"]},
            "evidence": {"$ref": "#/$defs/evidence"}, "metadata": {"$ref": "#/$defs/metadata"}}}}
      }}
  }
}
