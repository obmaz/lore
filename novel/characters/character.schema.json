{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["version", "revision", "characters"],
  "properties": {"version": {"const": 1}, "revision": {"type": "integer", "minimum": 1},
    "characters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/character"}}},
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["file", "line_start", "line_end"], "properties": {"file": {"type": "string"},
        "line_start": {"type": "integer", "minimum": 1}, "line_end": {"type": "integer", "minimum": 1}}}},
    "claim": {"type": "object", "additionalProperties": false,
      "required": ["field", "value", "origin", "status", "evidence"],
      "properties": {"field": {"type": "string"}, "value": {},
        "origin": {"enum": ["source_adaptation", "authored"]}, "status": {"enum": ["confirmed", "proposed"]},
        "evidence": {"$ref": "#/$defs/evidence"}}},
    "name": {"type": "object", "additionalProperties": false,
      "required": ["value", "origin", "literal_ids", "evidence"],
      "properties": {"value": {"type": ["string", "null"]},
        "origin": {"enum": ["source_exact", "source_adaptation", "authored"]},
        "literal_ids": {"$ref": "#/$defs/strings"}, "evidence": {"$ref": "#/$defs/evidence"}}},
    "character": {"type": "object", "additionalProperties": false,
      "required": ["revision", "kind", "canonical_name", "display_name", "aliases", "source_facts", "writing", "relationships"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["protagonist", "initial_candidate", "npc", "optional_companion", "antagonist"]},
        "canonical_name": {"$ref": "#/$defs/name"}, "display_name": {"type": "string", "minLength": 1},
        "aliases": {"$ref": "#/$defs/strings"},
        "source_facts": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "writing": {"type": "object", "additionalProperties": false,
          "required": ["status", "traits", "speech", "goals", "boundaries", "notes"],
          "properties": {"status": {"enum": ["outline", "draft", "approved"]},
            "traits": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
            "speech": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
            "goals": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
            "boundaries": {"$ref": "#/$defs/strings"}, "notes": {"type": "string"}}},
        "relationships": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["target", "description", "origin", "status", "evidence"],
          "properties": {"target": {"type": "string"}, "description": {"type": "string"},
            "origin": {"enum": ["source_adaptation", "authored"]}, "status": {"enum": ["confirmed", "proposed"]},
            "evidence": {"$ref": "#/$defs/evidence"}}}}
      }}
  }
}
