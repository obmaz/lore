{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["version", "revision", "policy", "groups", "dialogues"],
  "properties": {
    "version": {"const": 1}, "revision": {"type": "integer", "minimum": 1},
    "policy": {"type": "object", "additionalProperties": false,
      "required": ["subsection_titles", "speaker_labels", "source_boxes", "chapter_titles", "archive", "origin", "metadata"],
      "properties": {
        "subsection_titles": {"const": "author_only"}, "speaker_labels": {"const": false}, "source_boxes": {"const": false},
        "chapter_titles": {"const": "on_entry"}, "archive": {"const": "immutable_source_blocks"}, "origin": {"const": "authored"},
        "metadata": {"type": "object", "additionalProperties": false, "required": ["addition", "kind", "status", "note"],
          "properties": {"addition": {"const": true}, "kind": {"const": "new_setting"}, "status": {"const": "proposed"}, "note": {"type": "string", "minLength": 1}}}
      }},
    "groups": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["node", "block_ids", "kind", "editions", "provenance"],
      "properties": {"node": {"type": "string"}, "block_ids": {"$ref": "#/$defs/ids"},
        "kind": {"enum": ["speech", "inscription", "narration"]}, "editions": {"$ref": "#/$defs/editions"}, "provenance": {"$ref": "#/$defs/provenance"}}}},
    "dialogues": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false,
      "required": ["speaker", "editions", "provenance"],
      "properties": {"speaker": {"type": "string"}, "editions": {"$ref": "#/$defs/editions"}, "provenance": {"$ref": "#/$defs/provenance"}}}}
  },
  "$defs": {
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "ref": {"type": "object", "additionalProperties": false, "required": ["catalog", "id"], "properties": {
      "catalog": {"enum": ["characters", "equipment", "abilities", "bestiary", "terms"]}, "id": {"type": "string", "minLength": 1},
      "particle": {"enum": ["은/는", "이/가", "을/를", "과/와", "으로/로"]}}},
    "spans": {"type": "array", "items": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"text": {"type": "string"}}},
      {"type": "object", "additionalProperties": false, "required": ["ref"], "properties": {"ref": {"$ref": "#/$defs/ref"}}},
      {"type": "object", "additionalProperties": false, "required": ["state"], "properties": {"state": {"type": "string"}, "catalog": {"const": "characters"}, "particle": {"enum": ["은/는", "이/가", "을/를", "과/와", "으로/로"]}}}
    ]}},
    "edition": {"type": "object", "additionalProperties": false, "required": ["before", "after"],
      "properties": {"before": {"$ref": "#/$defs/spans"}, "after": {"$ref": "#/$defs/spans"}, "body": {"$ref": "#/$defs/spans", "minItems": 1}}},
    "editions": {"type": "object", "additionalProperties": false, "required": ["A", "B"], "properties": {"A": {"$ref": "#/$defs/edition"}, "B": {"$ref": "#/$defs/edition"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["origin", "source_block_ids", "note"],
      "properties": {"origin": {"enum": ["authored", "source_adaptation"]}, "source_block_ids": {"$ref": "#/$defs/ids"}, "note": {"type": "string", "minLength": 1}}}
  }
}
