{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lore.local/novel/writing/chapters.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["version", "revision", "kind", "visibility", "status", "source_board", "title", "reading_policy", "chapters", "side_stories", "open_questions"],
  "properties": {
    "version": {"const": 1}, "revision": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["series", "template"]}, "visibility": {"const": "author_only"}, "status": {"const": "outline"},
    "source_board": {"const": "storyboard/series.json"}, "title": {"$ref": "#/$defs/text"},
    "reading_policy": {"type": "object", "additionalProperties": false,
      "required": ["main_chapters", "optional_branches", "knowledge", "runtime_scope", "origin", "status", "metadata"],
      "properties": {
        "main_chapters": {"const": "mandatory"}, "optional_branches": {"const": "rejoin_before_next_required_beat"},
        "knowledge": {"const": "actual_route_only"}, "runtime_scope": {"const": "chapter01_only"},
        "origin": {"const": "authored"}, "status": {"const": "proposed"}, "metadata": {"$ref": "#/$defs/metadata"}
      }},
    "chapters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/chapter"}},
    "side_stories": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "title", "unit_ids", "mandatory", "placement", "origin", "status", "metadata"],
      "properties": {"id": {"type": "string"}, "title": {"$ref": "#/$defs/text"}, "unit_ids": {"$ref": "#/$defs/ids"},
        "mandatory": {"const": false}, "placement": {"type": ["string", "null"]}, "origin": {"const": "authored"},
        "status": {"const": "proposed"}, "metadata": {"$ref": "#/$defs/metadata"}}}},
    "open_questions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "text": {"$ref": "../authoring/story.schema.json#/$defs/richText"},
    "metadata": {"$ref": "../reference/metadata.schema.json#/$defs/metadata"},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "chapter": {"type": "object", "additionalProperties": false,
      "required": ["id", "number", "title", "unit_ids", "arc", "mandatory", "implementation", "origin", "status", "metadata", "exit_requires_all", "required_beats"],
      "properties": {
        "id": {"type": "string"}, "number": {"type": "integer", "minimum": 1}, "title": {"$ref": "#/$defs/text"},
        "unit_ids": {"$ref": "#/$defs/ids"}, "arc": {"type": "string"}, "mandatory": {"const": true},
        "implementation": {"enum": ["outline_only", "runtime_bound"]}, "origin": {"const": "authored"}, "status": {"const": "proposed"},
        "metadata": {"$ref": "#/$defs/metadata"}, "exit_requires_all": {"const": true},
        "required_beats": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
          "required": ["id", "summary", "source_anchors", "after", "scene_nodes", "origin", "status", "metadata"],
          "properties": {
            "id": {"type": "string"}, "summary": {"$ref": "#/$defs/text"}, "source_anchors": {"$ref": "#/$defs/ids"},
            "after": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "scene_nodes": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ids"}]},
            "origin": {"const": "inferred"}, "status": {"const": "proposed"}, "metadata": {"$ref": "#/$defs/metadata"}
          }}}
      }}
  }
}
