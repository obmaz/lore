{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profile", "chapter_id", "chapter_limit", "style_revision", "status", "shared_structure", "base_source_sha256", "metadata", "block_overrides"],
  "properties": {
    "version": {"const": 1}, "profile": {"const": "B"}, "chapter_id": {"type": "string", "pattern": "^chapter[0-9]{2}$"}, "chapter_limit": {"type": "integer", "minimum": 1},
    "style_revision": {"type": "integer", "minimum": 1}, "status": {"const": "draft"},
    "shared_structure": {"const": "writing/interactive/series.json"},
    "base_source_sha256": {"type": "object", "minProperties": 3, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "metadata": {"type": "object", "required": ["origin", "status", "addition", "kind", "note"], "additionalProperties": false, "properties": {"origin": {"const": "authored"}, "status": {"const": "proposed"}, "addition": {"const": true}, "kind": {"const": "new_setting"}, "note": {"type": "string", "minLength": 1}}},
    "block_overrides": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["text", "provenance"], "properties": {"text": {"type": "array", "minItems": 1}, "provenance": {"type": "object", "required": ["origin", "source_refs", "note"], "additionalProperties": false, "properties": {"origin": {"const": "authored"}, "source_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "note": {"type": "string", "minLength": 1}}}}}}
  }
}
