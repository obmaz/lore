{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lore.local/novel/writing/chapter-stories.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["version", "revision", "kind", "visibility", "status", "chapter_plan", "workflow", "origin", "metadata", "premise", "acts", "chapters", "refinement_notes", "open_questions"],
  "properties": {
    "version": {"const": 1}, "revision": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["series", "template"]}, "visibility": {"const": "author_only"}, "status": {"const": "draft"},
    "chapter_plan": {"const": "storyboard/chapters.json"},
    "workflow": {"type": "object", "additionalProperties": false,
      "required": ["stage", "branch_design", "detail_design", "existing_chapter01", "dialogue_policy", "primary_scenario"],
      "properties": {
        "stage": {"const": "macro_story_first"}, "branch_design": {"const": "deferred"}, "detail_design": {"const": "deferred"},
        "existing_chapter01": {"const": "preserve_existing_draft"},
        "dialogue_policy": {"const": "bind_all_applicable_original_occurrences_when_detailing"},
        "primary_scenario": {"const": "successful_main_progress_not_all_routes"}
      }},
    "origin": {"const": "authored"}, "metadata": {"$ref": "#/$defs/metadata"},
    "premise": {"$ref": "#/$defs/text"},
    "acts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "chapter_ids", "summary"], "properties": {
        "id": {"type": "string"}, "chapter_ids": {"$ref": "#/$defs/ids"}, "summary": {"$ref": "#/$defs/text"}}}},
    "chapters": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["chapter_id", "mandatory", "beat_refs", "source_section_refs", "story", "dramatic_question", "emotional_change", "handoff", "parallel_beat_groups", "continuity_limits", "origin", "status", "metadata"],
      "properties": {
        "chapter_id": {"type": "string"}, "mandatory": {"const": true}, "beat_refs": {"$ref": "#/$defs/ids"},
        "source_section_refs": {"$ref": "#/$defs/ids"},
        "story": {"type": "object", "additionalProperties": false,
          "required": ["opening", "escalation", "turning_point", "ending"], "properties": {
            "opening": {"$ref": "#/$defs/text"}, "escalation": {"$ref": "#/$defs/text"},
            "turning_point": {"$ref": "#/$defs/text"}, "ending": {"$ref": "#/$defs/text"}}},
        "dramatic_question": {"$ref": "#/$defs/text"}, "emotional_change": {"$ref": "#/$defs/text"},
        "handoff": {"type": "object", "additionalProperties": false, "required": ["next_chapter", "reason"],
          "properties": {"next_chapter": {"type": ["string", "null"]}, "reason": {"$ref": "#/$defs/text"}}},
        "parallel_beat_groups": {"type": "array", "items": {"$ref": "#/$defs/ids"}},
        "continuity_limits": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "origin": {"const": "authored"}, "status": {"const": "draft"}, "metadata": {"$ref": "#/$defs/metadata"}
      }}},
    "refinement_notes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "text": {"$ref": "../authoring/story.schema.json#/$defs/richText"},
    "metadata": {"$ref": "../reference/metadata.schema.json#/$defs/metadata"},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
