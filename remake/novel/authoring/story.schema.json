{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lore/story-authoring/v2",
  "title": "LORE interactive story authoring document (not game rules)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meta", "source_refs", "state_definitions", "entry_node", "nodes", "coverage", "open_questions"],
  "properties": {
    "schema_version": {"const": 2},
    "meta": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "quest_id", "status", "purpose", "summary", "revision", "source_catalog", "character_registry"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "quest_id": {"type": "string"},
        "status": {"enum": ["outline", "draft", "source_review", "editorial_review", "approved"]},
        "purpose": {"const": "story_authoring_not_game_runtime"},
        "summary": {"type": "string"},
        "revision": {"type": "integer", "minimum": 1},
        "source_catalog": {"const": "materials/scripts.json"},
        "character_registry": {"const": "characters/registry.json"}
      }
    },
    "source_refs": {
      "type": "object", "additionalProperties": {"$ref": "#/$defs/sourceRef"}
    },
    "state_definitions": {
      "type": "object", "additionalProperties": {"$ref": "#/$defs/state"}
    },
    "entry_node": {"type": "string"},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "required_source_refs", "deferred_source_refs", "literal_dispositions", "notes"],
      "properties": {
        "status": {"enum": ["partial", "complete"]},
        "required_source_refs": {"$ref": "#/$defs/refs"},
        "deferred_source_refs": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["ref", "reason"],
            "properties": {"ref": {"type": "string"}, "reason": {"type": "string", "minLength": 1}}
          }
        },
        "literal_dispositions": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["literal_id", "handling", "block_ids", "choice_ids", "reason"],
            "properties": {
              "literal_id": {"type": "string"},
              "handling": {"enum": ["verbatim", "adapted", "alternate_path", "pending", "non_story"]},
              "block_ids": {"$ref": "#/$defs/refs"}, "choice_ids": {"$ref": "#/$defs/refs"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "notes": {"type": "string"}
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["origin", "source_refs", "note"],
      "properties": {
        "origin": {"enum": ["source_exact", "source_adaptation", "authored"]},
        "source_refs": {"$ref": "#/$defs/refs"},
        "note": {"type": "string"}
      }
    },
    "sourceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "line_start", "line_end", "purpose"],
      "properties": {
        "file": {"type": "string"},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "scene_id": {"type": "string"},
        "purpose": {"type": "string"}
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "category", "scope", "initial", "description", "provenance"],
      "properties": {
        "type": {"enum": ["boolean", "integer", "string", "string_set"]},
        "category": {"enum": ["knowledge", "companions", "relationship", "event", "quest"]},
        "scope": {"enum": ["quest", "story"]},
        "initial": {},
        "description": {"type": "string"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "source_mapping": {"type": "string"}
      }
    },
    "predicate": {
      "oneOf": [
        {"type": "boolean"},
        {"type": "object", "additionalProperties": false, "required": ["all"], "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/predicate"}}}},
        {"type": "object", "additionalProperties": false, "required": ["any"], "properties": {"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/predicate"}}}},
        {"type": "object", "additionalProperties": false, "required": ["not"], "properties": {"not": {"$ref": "#/$defs/predicate"}}},
        {"type": "object", "additionalProperties": false, "required": ["state", "op", "value"], "properties": {
          "state": {"type": "string"}, "op": {"enum": ["eq", "ne", "gte", "lte", "contains", "not_contains"]}, "value": {}
        }}
      ]
    },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "op", "value", "provenance"],
      "properties": {
        "state": {"type": "string"}, "op": {"enum": ["set", "increment", "add", "remove"]},
        "value": {}, "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "block": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "speaker", "when", "text", "literal_ids", "provenance"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["narration", "dialogue", "source_quote", "author_note"]},
        "speaker": {"type": ["string", "null"]},
        "when": {"$ref": "#/$defs/predicate"},
        "text": {"type": "string"},
        "literal_ids": {"$ref": "#/$defs/refs"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "choice": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "when", "target", "effects", "branch_kind", "consequence", "provenance"],
      "properties": {
        "id": {"type": "string"}, "label": {"type": "string"},
        "label_literal_id": {"type": "string"},
        "when": {"$ref": "#/$defs/predicate"}, "target": {"type": "string"},
        "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "branch_kind": {"enum": ["navigation", "flavor", "knowledge", "companion", "relationship", "quest", "ending"]},
        "consequence": {"type": "string"}, "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "kind", "entry_when", "provenance", "blocks", "choices", "handoff", "editorial"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "title": {"type": "string"},
        "kind": {"enum": ["scene", "hub", "branch", "merge", "boundary", "ending"]},
        "entry_when": {"$ref": "#/$defs/predicate"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}},
        "choices": {"type": "array", "items": {"$ref": "#/$defs/choice"}},
        "handoff": {
          "oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
            "required": ["quest_id", "entry_node", "carry_states"],
            "properties": {"quest_id": {"type": "string"}, "entry_node": {"type": ["string", "null"]}, "carry_states": {"$ref": "#/$defs/refs"}}}]
        },
        "editorial": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "intent", "source_refs", "notes"],
          "properties": {
            "status": {"enum": ["outline", "draft", "reviewed"]}, "intent": {"type": "string"},
            "source_refs": {"$ref": "#/$defs/refs"}, "notes": {"type": "string"}
          }
        }
      }
    }
  }
}
